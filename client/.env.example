# Client Environment Variables (Vercel Production Configuration)

# Backend API URL (Points to your Render backend deployment)
# Example: https://foodrescue-api.onrender.com (or /api for local dev proxy)
VITE_API_URL=https://foodrescue-api.onrender.com

# Enable/disable public one-click demo login buttons in production builds (defaults to false in production)
VITE_ENABLE_DEMO_LOGINS=false

