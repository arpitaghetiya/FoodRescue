# Server Environment Variables (Render Production Configuration)
PORT=5000
NODE_ENV=production

# Database Connection (Neon PostgreSQL URL)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
# Generate a strong 32+ character random string for production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (Required in production)
ADMIN_PASSWORD=replace_with_a_secure_custom_admin_password

# Client URL (Allowed CORS Origin, e.g. your Vercel deployment URL)
CLIENT_URL=https://foodrescue.vercel.app

